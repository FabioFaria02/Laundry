rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function valid(d) {
      return d.keys().hasOnly(['machine', 'person', 'start', 'end', 'createdAt'])
        && d.machine in ['washer', 'dryer']
        && d.person is string && d.person.size() > 0 && d.person.size() <= 30
        && d.start is number && d.end is number
        && d.end > d.start
        && d.end - d.start <= 2 * 60 * 60 * 1000; // 50 CZK = 2 hours
    }

    match /bookings/{id} {
      allow read: if true;
      allow create: if valid(request.resource.data);
      // only "finish early": shortening the end time
      allow update: if valid(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['end'])
        && request.resource.data.end <= resource.data.end;
      allow delete: if true;
    }
  }
}
