rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validBooking(d) {
      return d.keys().hasOnly(['machine', 'person', 'start', 'end', 'createdAt', 'done'])
        && d.machine in ['washer', 'dryer']
        && d.person is string && d.person.size() > 0 && d.person.size() <= 30
        && d.start is number && d.end is number
        && d.end > d.start
        // new bookings are limited to 2 h (50 CZK) in the app; adjusting the
        // remaining time from the machine display may stretch one a bit further
        && d.end - d.start <= 4 * 60 * 60 * 1000
        && (!('done' in d) || d.done is bool);
    }

    match /bookings/{id} {
      allow read: if true;
      allow create: if validBooking(request.resource.data);
      // only "I'm done": shortening the end time and marking it done
      allow update: if validBooking(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['end', 'done'])
        && request.resource.data.end <= resource.data.end;
      allow delete: if true;
    }

    // one document per phone that wants reminders (Web Push subscription)
    match /pushSubs/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['person', 'lang', 'tz', 'endpoint', 'p256dh', 'auth', 'updatedAt'])
        && request.resource.data.person is string && request.resource.data.person.size() <= 30
        && request.resource.data.endpoint is string && request.resource.data.endpoint.size() < 1000
        && request.resource.data.endpoint.matches('https://.*');
    }

    // reminders already sent (written by the GitHub Action, never changed)
    match /sent/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['at']) && request.resource.data.at is number;
    }
  }
}
